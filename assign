                <li>Power BI</li>
            </ul>
        </section>

        <section>
            <h2>Projects</h2>
            <p>Product Inventory System</p>
            <p>Employee Attrition Prediction</p>
        </section>
    </div>

    <!-- Assignment 3: Profile Card -->
    <section class="profile-container" id="profile">
        <div class="profile-card">
            <div class="avatar">A</div>
            <h2>Ansh Pratap Srivastava</h2>
            <p>BCA AI Student</p>

            <p>Passionate about technology, coding and AI.</p>

            <div class="skills">
                <span>Python</span>
                <span>HTML</span>
                <span>CSS</span>
                <span>SQL</span>
            </div>

            <a href="mailto:a3902179@gmail.com" class="button">
                Contact Me
            </a>
        </div>
    </section>

    <!-- Assignment 4: Landing Page -->
    <section class="hero" id="landing">
        <h1>Build Your Future with Technology</h1>
        <p>Learn new skills, explore innovative ideas
           and create something amazing.</p>
        <a href="#features" class="button">Explore More</a>
    </section>

    <section class="features" id="features">
        <div class="feature">
            <h2>Web Development</h2>
            <p>Create modern and responsive websites.</p>
        </div>

        <div class="feature">
            <h2>Artificial Intelligence</h2>
            <p>Explore intelligent and smart solutions.</p>
        </div>

        <div class="feature">
