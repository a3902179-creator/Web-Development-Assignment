<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CSS Assignments 1-4</title>
    <link rel="stylesheet" href="assign.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f1f5f9;
            color: #1e293b;
            line-height: 1.6;
        }

        /* Assignment 1: Styled Webpage */
        .website-header {
            background: #2563eb;
            color: white;
            text-align: center;
            padding: 30px;
        }

        nav {
            background: #0f172a;
            text-align: center;
            padding: 15px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin: 0 12px;
        }

        nav a:hover {
            color: #93c5fd;
        }

        .section {
            max-width: 900px;
            margin: 25px auto;
            padding: 25px;
            background: white;
            border: 1px solid #ddd;
            border-radius: 10px;
        }

        h2 {
            color: #2563eb;
            margin-bottom: 12px;
        }

        /* Assignment 2: Resume */
        .resume {
            max-width: 850px;
            margin: 30px auto;
            padding: 30px;
            background: white;
            border: 2px solid #dbeafe;
            border-radius: 12px;
            box-shadow: 0 5px 15px #00000015;
        }

        .resume-header {
            background: #17365d;
            color: white;
            text-align: center;
            padding: 25px;
            border-radius: 8px;
            margin-bottom: 25px;
        }

        .resume-header h2 {
            color: white;
        }

        .resume section {
            margin-bottom: 22px;
            padding-bottom: 15px;
            border-bottom: 1px solid #ddd;
        }

        /* Assignment 3: Profile Card */
        .profile-container {
            display: flex;
            justify-content: center;
            padding: 40px 15px;
            background: #dbeafe;
        }

        .profile-card {
            width: 350px;
            padding: 30px;
            margin: 10px;
            border: 2px solid #bfdbfe;
            border-radius: 15px;
            background: white;
            text-align: center;
            box-shadow: 0 8px 20px #00000015;
        }

        .avatar {
            width: 90px;
            height: 90px;
            margin: 0 auto 15px;
            border-radius: 50%;
            background: #2563eb;
            color: white;
            font-size: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .skills span {
            display: inline-block;
            padding: 6px 12px;
            margin: 5px 2px;
            background: #dbeafe;
            color: #1d4ed8;
            border-radius: 20px;
        }

        .button {
            display: inline-block;
            margin-top: 15px;
            padding: 10px 20px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            border-radius: 6px;
        }

        /* Assignment 4: Landing Page */
        .hero {
            padding: 70px 20px;
            text-align: center;
            color: white;
            background: linear-gradient(135deg, #172554, #2563eb, #7c3aed);
        }

        .hero h1 {
            font-size: 38px;
            margin-bottom: 15px;
        }

        .hero p {
            margin-bottom: 20px;
        }

        .hero .button {
            background: white;
            color: #1d4ed8;
        }

        .features {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 20px;
            padding: 35px 15px;
        }

        .feature {
            width: 250px;
            padding: 25px;
            background: white;
            border: 1px solid #ddd;
            border-radius: 10px;
            text-align: center;
        }

        footer {
            padding: 20px;
            background: #0f172a;
            color: white;
            text-align: center;
        }

        @media (max-width: 600px) {
            .resume {
                margin: 15px;
                padding: 18px;
            }

            .hero h1 {
                font-size: 28px;
            }

            nav a {
                display: inline-block;
                margin: 5px;
            }
        }
    </style>
</head>

<body>

    <!-- Assignment 1: Styled Webpage -->
    <header class="website-header" id="home">
